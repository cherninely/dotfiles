#!/usr/bin/env python3
"""One-shot call to the local Reactor MCP server, without keeping it running.

reactor is not on the mcp.yandex.net gateway, so `ya tool mcp cli` cannot reach it;
this starts ~/.mcp_servers/reactor/reactor_mcp over stdio, makes one request and exits.

  reactor-call --list                  tool names with the first line of each description
  reactor-call --help TOOL             input schema of TOOL
  reactor-call TOOL [key=value ...]    call TOOL; key:=JSON for numbers, lists, objects
  reactor-call TOOL --json '{...}'     all arguments as one JSON object
"""
import json
import os
import subprocess
import sys

SERVER = os.path.expanduser("~/.mcp_servers/reactor/reactor_mcp")
TOKEN = os.path.expanduser("~/.nirvana/token")


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(2)


class Server:
    def __init__(self):
        env = dict(os.environ, NO_PROXY="*", no_proxy="*")
        self.proc = subprocess.Popen(
            [SERVER, "--oauth-file", TOKEN],
            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            env=env, text=True,
        )
        self.next_id = 0
        self.request("initialize", {
            "protocolVersion": "2025-06-18",
            "capabilities": {},
            "clientInfo": {"name": "reactor-call", "version": "1"},
        })
        self.send({"jsonrpc": "2.0", "method": "notifications/initialized"})

    def send(self, msg):
        self.proc.stdin.write(json.dumps(msg) + "\n")
        self.proc.stdin.flush()

    def request(self, method, params):
        self.next_id += 1
        self.send({"jsonrpc": "2.0", "id": self.next_id, "method": method, "params": params})
        for line in self.proc.stdout:
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if msg.get("id") != self.next_id:
                continue
            if "error" in msg:
                die(json.dumps(msg["error"], ensure_ascii=False))
            return msg["result"]
        die("reactor_mcp exited without an answer")

    def close(self):
        self.proc.stdin.close()
        try:
            self.proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            self.proc.kill()


def parse_args(pairs):
    if len(pairs) == 2 and pairs[0] == "--json":
        return json.loads(pairs[1])
    args = {}
    for pair in pairs:
        if ":=" in pair:
            key, value = pair.split(":=", 1)
            args[key] = json.loads(value)
        elif "=" in pair:
            key, value = pair.split("=", 1)
            args[key] = value
        else:
            die(f"argument without '=': {pair}")
    return args


def main(argv):
    if not argv or argv[0] in ("-h", "--usage"):
        print(__doc__.strip())
        return 0
    server = Server()
    try:
        if argv[0] == "--list":
            for tool in server.request("tools/list", {})["tools"]:
                first = (tool.get("description") or "").strip().splitlines()
                print(f"{tool['name']}\t{first[0] if first else ''}")
        elif argv[0] == "--help":
            if len(argv) < 2:
                die("--help needs a tool name")
            tools = {t["name"]: t for t in server.request("tools/list", {})["tools"]}
            if argv[1] not in tools:
                die(f"unknown tool {argv[1]}; see reactor-call --list")
            tool = tools[argv[1]]
            print(tool.get("description", "").strip())
            print(json.dumps(tool.get("inputSchema", {}), indent=2, ensure_ascii=False))
        else:
            result = server.request("tools/call", {"name": argv[0], "arguments": parse_args(argv[1:])})
            for item in result.get("content", []):
                print(item.get("text", json.dumps(item, ensure_ascii=False)))
            if result.get("structuredContent") and not result.get("content"):
                print(json.dumps(result["structuredContent"], indent=2, ensure_ascii=False))
            return 1 if result.get("isError") else 0
    finally:
        server.close()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
