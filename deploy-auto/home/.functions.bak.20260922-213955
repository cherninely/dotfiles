#!/usr/bin/env bash

# Create a new directory and enter it
function mkd() {
    mkdir -p "$@" && cd "$_";
}

# tm-boot: start the tmux server if it is not running (i.e. after a reboot).
# The first session is tmux's default "0" with a single pane: only then
# resurrect treats the restore as "from scratch" and removes "0" afterwards,
# so continuum brings the saved sessions back without leaving a stray one.
function tm-boot() {
    local socket="/tmp/tm-$(whoami)" i
    tmux -S "$socket" has-session 2>/dev/null && return
    tmux -2 -S "$socket" new-session -d
    for i in $(seq 1 30); do
        tmux -S "$socket" has-session -t 0 2>/dev/null || break
        sleep 1
    done
}

# tma [name]: no arg -> attach last session, with arg -> attach specific
function tma() {
    tm-boot
    if [ $# -eq 0 ]; then
        tmux -2 -S "/tmp/tm-$(whoami)" attach;
    else
        tmux -2 -S "/tmp/tm-$(whoami)" attach -t "$1";
    fi
}

# tm [name]: создать новую сессию с двумя сплитами (слева под nvim, справа сразу
# стартует claude через cs). Имя берётся из аргумента или из basename текущей директории.
function tm() {
    local socket="/tmp/tm-$(whoami)"
    local name="${1:-$(basename "$PWD")}"

    tm-boot
    if tmux -2 -S "$socket" has-session -t "$name" 2>/dev/null; then
        tmux -2 -S "$socket" attach -t "$name"
        return
    fi

    tmux -2 -S "$socket" new-session  -d -s "$name" -n root -c "$PWD"
    tmux -2 -S "$socket" split-window -h -t "$name" -l 40%
    tmux -2 -S "$socket" send-keys    -t "${name}.2" "cs -n $(printf '%q' "$name")" Enter
    tmux -2 -S "$socket" select-pane  -t "${name}.1"
    tmux -2 -S "$socket" attach       -t "$name"
}

# tmh [name]: tm, но сессия (и claude в ней) всегда стартует в каталоге Hyperenv.
function tmh() {
    local dir="$HOME/arcadia/hyperenv"
    if [ ! -d "$dir" ]; then
        echo "tmh: нет каталога $dir — arc примонтирован?" >&2
        return 1
    fi
    (cd "$dir" && tm "${1:-hyperenv}")
}

# cs [args]: claude на личной подписке (прокси-переменные сброшены, модель из settings.json).
# В tmux разговор получает постоянный UUID (--session-id): tmux-resurrect сохраняет его в
# командной строке панели и после ребута запускает ту же строку через `cs *` (@resurrect-processes).
# Claude отказывает в --session-id для уже существующего разговора — тогда флаг переводится в --resume.
function cs() {
    local uuid="" explicit=""
    local -a args
    args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --session-id)   uuid="$2"; shift 2; continue ;;
            --session-id=*) uuid="${1#*=}"; shift; continue ;;
            -r|--resume|-c|--continue|--from-pr|--teleport) explicit=1 ;;
        esac
        args+=("$1")
        shift
    done

    # Transcripts are kept per project directory and --resume only looks in the
    # current one, so a uuid the pane remembers for another directory is useless here.
    local project; project=~/.claude/projects/$(pwd -P | sed 's/[^A-Za-z0-9-]/-/g')

    if [ -n "$TMUX" ] && [ -z "$uuid" ] && [ -z "$explicit" ]; then
        uuid="$(tmux show-options -pqv @cc_uuid 2>/dev/null)"
        if [ -n "$uuid" ] && [ ! -f "$project/$uuid.jsonl" ] \
            && [ -n "$(find ~/.claude/projects -maxdepth 2 -name "$uuid.jsonl" 2>/dev/null | head -1)" ]; then
            uuid=""
        fi
        [ -n "$uuid" ] || uuid="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    fi

    if [ -n "$uuid" ]; then
        [ -n "$TMUX" ] && tmux set-option -p @cc_uuid "$uuid" 2>/dev/null
        if [ -f "$project/$uuid.jsonl" ]; then
            args=(--resume "$uuid" "${args[@]}")
        else
            args=(--session-id "$uuid" "${args[@]}")
        fi
    fi

    env -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL -u ANTHROPIC_MODEL claude "${args[@]}"
}

# Change working directory to the top-most Finder window location
function cdf() { # short for `cdfinder`
    cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')";
}

# Create a .tar.gz archive, using `zopfli`, `pigz` or `gzip` for compression
function targz() {
    local tmpFile="${@%/}.tar";
    tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1;

    size=$(
        stat -f"%z" "${tmpFile}" 2> /dev/null; # macOS `stat`
        stat -c"%s" "${tmpFile}" 2> /dev/null;  # GNU `stat`
    );

    local cmd="";
    if (( size < 52428800 )) && hash zopfli 2> /dev/null; then
        # the .tar file is smaller than 50 MB and Zopfli is available; use it
        cmd="zopfli";
    else
        if hash pigz 2> /dev/null; then
            cmd="pigz";
        else
            cmd="gzip";
        fi;
    fi;

    echo "Compressing .tar ($((size / 1000)) kB) using \`${cmd}\`…";
    "${cmd}" -v "${tmpFile}" || return 1;
    [ -f "${tmpFile}" ] && rm "${tmpFile}";

    zippedSize=$(
        stat -f"%z" "${tmpFile}.gz" 2> /dev/null; # macOS `stat`
        stat -c"%s" "${tmpFile}.gz" 2> /dev/null; # GNU `stat`
    );

    echo "${tmpFile}.gz ($((zippedSize / 1000)) kB) created successfully.";
}

# Determine size of a file or total size of a directory
function fs() {
    if du -b /dev/null > /dev/null 2>&1; then
        local arg=-sbh;
    else
        local arg=-sh;
    fi
    if [[ -n "$@" ]]; then
        du $arg -- "$@";
    else
        du $arg .[^.]* ./*;
    fi;
}

# Use Git’s colored diff when available
hash git &>/dev/null;
if [ $? -eq 0 ]; then
    function diff() {
        git diff --no-index --color-words "$@";
    }
fi;

# Create a data URL from a file
function dataurl() {
    local mimeType=$(file -b --mime-type "$1");
    if [[ $mimeType == text/* ]]; then
        mimeType="${mimeType};charset=utf-8";
    fi
    echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')";
}

# Start an HTTP server from a directory, optionally specifying the port
function server() {
    local port="${1:-8000}";
    sleep 1 && open "http://localhost:${port}/" &
    # Set the default Content-Type to `text/plain` instead of `application/octet-stream`
    # And serve everything as UTF-8 (although not technically correct, this doesn’t break anything for binary files)
    python -c $'import SimpleHTTPServer;\nmap = SimpleHTTPServer.SimpleHTTPRequestHandler.extensions_map;\nmap[""] = "text/plain";\nfor key, value in map.items():\n\tmap[key] = value + ";charset=UTF-8";\nSimpleHTTPServer.test();' "$port";
}

# Compare original and gzipped file size
function gz() {
    local origsize=$(wc -c < "$1");
    local gzipsize=$(gzip -c "$1" | wc -c);
    local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l);
    printf "orig: %d bytes\n" "$origsize";
    printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio";
}

# Run `dig` and display the most useful info
function digga() {
    dig +nocmd "$1" any +multiline +noall +answer;
}

# Normalize `open` across Linux, macOS, and Windows.
# This is needed to make the `o` function (see below) cross-platform.
if [ ! $(uname -s) = 'Darwin' ]; then
    if grep -q Microsoft /proc/version; then
        # Ubuntu on Windows using the Linux subsystem
        alias open='explorer.exe';
    else
        alias open='xdg-open';
    fi
fi

# `o` with no arguments opens the current directory, otherwise opens the given
# location
function o() {
    if [ $# -eq 0 ]; then
        open .;
    else
        open "$@";
    fi;
}

# tm-resource: re-source ~/.zshrc во всех shell-пейнах всех tmux-сессий.
# Пейны с активной интерактивкой (nvim, less, claude и т.п.) пропускаются,
# чтобы не отправить туда мусор.
function tm-resource() {
    local socket="/tmp/tm-$(whoami)"
    tmux -S "$socket" list-panes -a -F '#{pane_id} #{pane_current_command}' \
        | awk '$2 ~ /^(zsh|bash|-zsh|-bash)$/ {print $1}' \
        | xargs -I{} tmux -S "$socket" send-keys -t {} ' source ~/.zshrc' Enter
}

# `tre` is a shorthand for `tree` with hidden files and color enabled, ignoring
# the `.git` directory, listing directories first. The output gets piped into
# `less` with options to preserve color and line numbers, unless the output is
# small enough for one screen.
function tre() {
    tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}
