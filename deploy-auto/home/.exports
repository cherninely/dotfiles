#!/usr/bin/env bash

export PATH=/opt/homebrew/bin:$PATH
export PATH=./node_modules/.bin:$PATH
export PATH=~/node_modules/.bin:$PATH
export PATH=/usr/local/share/npm/bin:$PATH
export PATH=~/bin:$PATH
export PATH=.bin:$PATH
export PATH=bin:$PATH
export PATH=~/dotfiles/bin:$PATH
export PATH=$HOME/.local/bin:$HOME/bin:$PATH
PATH="$HOME/arcadia:$PATH"

export NODE_PATH=./node_modules:$NODE_PATH

export NVM_DIR="$HOME/.nvm"
# Полная загрузка nvm.sh стоит ~0.4 c на каждое новое окно, и почти всё это —
# резолв версии из alias/default. Кладём её на PATH сами, а сам nvm подтягиваем
# только когда его позвали. Нестандартный default (lts/*, node) — грузим как раньше.
_nvm_default=""
[ -r "$NVM_DIR/alias/default" ] && _nvm_default="$(<"$NVM_DIR/alias/default")"
if [ -n "$_nvm_default" ] && [ -d "$NVM_DIR/versions/node/$_nvm_default/bin" ]; then
    PATH="$NVM_DIR/versions/node/$_nvm_default/bin:$PATH"
    nvm() {
        unfunction nvm
        \. "/opt/homebrew/opt/nvm/nvm.sh"
        [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
        nvm "$@"
    }
elif [ -s "/opt/homebrew/opt/nvm/nvm.sh" ]; then
    \. "/opt/homebrew/opt/nvm/nvm.sh"
    [ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && \. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
fi
unset _nvm_default

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export BLOCKSIZE=K      # FreeBSD only

# Make nvim the default editor.
export EDITOR=nvim

export PAGER=less
export CLICOLOR=yes; # git colors
# TERM is set by the terminal emulator (iTerm -> xterm-256color).
# Inside tmux it becomes screen-256color automatically. Do NOT force it here.

# Highlight section titles in manual pages.
# http://habrahabr.ru/post/153871/
export LESS_TERMCAP_mb=$MAGENTA
export LESS_TERMCAP_md=$ORANGE
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_so=$'\E[42;30m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_us=$'\E[32m'
export LESS_TERMCAP_ue=$'\E[0m'

# Don’t clear the screen after quitting a manual page.
export MANPAGER='less -X';

# Increase Bash history size. Allow 32³ entries; the default is 500.
export HISTSIZE=32768
export HISTFILESIZE=$HISTSIZE
export HISTCONTROL=ignoredups
export HISTCONTROL=ignoreboth

# Make some commands not show up in history
export HISTIGNORE="ls:cd:cd -:pwd:exit:date:* --help:st:sup:gs:fg"

# fix sorting against underscores
export LC_COLLATE=C

# Hide the “default interactive shell is now zsh” warning on macOS.
export BASH_SILENCE_DEPRECATION_WARNING=1;

# pyenv
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
# Развёрнутый вывод `pyenv init -`: он же, но без запуска bash для чистки PATH
# и без `pyenv rehash` — вместе это ~0.24 c на окно. Rehash нужен только после
# установки пакетов с бинарниками, тогда вызови `pyenv rehash` руками.
export PATH="$PYENV_ROOT/shims:$PATH"
export PYENV_SHELL=zsh
[ -r /opt/homebrew/opt/pyenv/completions/pyenv.zsh ] && \
    source /opt/homebrew/opt/pyenv/completions/pyenv.zsh
pyenv() {
    local command=${1:-}
    [ "$#" -gt 0 ] && shift
    case "$command" in
    rehash|shell) eval "$(command pyenv "sh-$command" "$@")" ;;
    *)            command pyenv "$command" "$@" ;;
    esac
}

# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

[ -f "$HOME/.exports_ignore" ] && source "$HOME/.exports_ignore"
